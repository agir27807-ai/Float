<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floatingRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Compact Floating Bar -->
    <LinearLayout
        android:id="@+id/floatingBarContainer"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:background="@drawable/bg_floating_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/btnDragHandle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Drag to move overlay"
            android:padding="6dp"
            android:src="@drawable/ic_drag_handle" />

        <TextView
            android:id="@+id/txtFloatingEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxWidth="150dp"
            android:singleLine="true"
            android:text="Waiting for mail..."
            android:textColor="#F4F4F5"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/btnCopyOtp"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_otp_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="OTP Lock"
                android:src="@drawable/ic_lock" />

            <TextView
                android:id="@+id/txtFloatingOtp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:text="OTP: ----"
                android:textColor="#4ADE80"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnTogglePreview"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="@android:color/transparent"
            android:contentDescription="Toggle latest mail preview"
            android:src="@drawable/ic_chevron_down" />
    </LinearLayout>

    <!-- Expandable Latest Mail Preview -->
    <LinearLayout
        android:id="@+id/previewDrawer"
        android:layout_width="290dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_floating_bar"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtPreviewService"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Facebook latest mail"
                android:textColor="#E4E4E7"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPreviewDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text=""
                android:textColor="#A1A1AA"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtPreviewContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Auto-reading saved mailboxes every 3s."
            android:textColor="#F4F4F5"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
